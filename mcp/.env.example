# Only needed for standalone dev (pointing this MCP server at a milaclone
# instance other than the bundled ../app one). The combined root
# docker-compose.yml wires MILACLONE_URL/MILACLONE_API_KEY automatically —
# you don't need this file for that deployment.

# URL of the milaclone instance (no trailing slash).
MILACLONE_URL=http://localhost:4321

# Only required if that instance was started with API_KEY set.
MILACLONE_API_KEY=

# Transport for this server itself: stdio (default, for local Claude Code)
# or streamable-http (persistent network service).
MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
MCP_PORT=8383

# Bearer token required on requests when MCP_TRANSPORT=streamable-http.
# Leave blank to run open. Ignored for stdio.
MCP_AUTH_TOKEN=

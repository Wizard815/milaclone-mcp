# URL of your running milaclone instance (no trailing slash).
# Local dev:      http://localhost:4321
# Over Tailscale: https://mila.your-tailnet.ts.net
MILACLONE_URL=http://localhost:4321

# Only required if milaclone was started with API_KEY set (see its README).
# Leave blank if the instance has no API_KEY configured.
MILACLONE_API_KEY=

# --- Only used when running as a network service (Docker/Unraid) ---------
# stdio (default): Claude Code/Desktop spawns this process locally, no
# network exposure. streamable-http: runs a persistent HTTP server other
# machines can connect to (what the Dockerfile uses).
MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
MCP_PORT=8383

# Bearer token required on every request when MCP_TRANSPORT=streamable-http.
# Leave blank to run open (fine if only reachable over Tailscale, same trust
# model milaclone itself uses). Ignored for stdio.
MCP_AUTH_TOKEN=

# URL of your running milaclone instance (no trailing slash).
# Local dev:      http://localhost:4321
# Over Tailscale: https://mila.your-tailnet.ts.net
MILACLONE_URL=http://localhost:4321

# Only required if milaclone was started with API_KEY set (see its README).
# Leave blank if the instance has no API_KEY configured.
MILACLONE_API_KEY=

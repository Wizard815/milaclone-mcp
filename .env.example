# Shared secret protecting milaclone's /api/*. app enforces it, mcp sends it
# automatically — set it once here. Leave blank to run the API open (fine on
# a trusted LAN + tunnel setup, no different from milaclone's old default).
API_KEY=

# Bearer token required to call the MCP server's own /mcp endpoint (over
# your Cloudflare Tunnel or LAN). Independent from API_KEY above. Leave
# blank to run it open.
MCP_AUTH_TOKEN=

# Where board data / uploads live on the host. Defaults (if left unset) to
# /mnt/user/appdata/milaclone-mcp/{data,uploads} — Unraid's standard appdata
# location, visible in the array and covered by the CA Backup plugin.
# Uncomment and change only if you want them somewhere else.
# DATA_PATH=/mnt/user/appdata/milaclone-mcp/data
# UPLOADS_PATH=/mnt/user/appdata/milaclone-mcp/uploads

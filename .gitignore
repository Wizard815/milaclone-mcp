# shared
.env
*.log

# app/ (Node)
app/node_modules/
app/data/
app/public/uploads/*
!app/public/uploads/.gitkeep
app/.e2e-data/
app/test-results/
app/playwright-report/
# test coverage output
app/coverage/
# esbuild output (server.js builds it at boot)
app/public/vendor/

# mcp/ (Python)
mcp/__pycache__/
mcp/**/__pycache__/
mcp/**/*.pyc
mcp/.venv/
mcp/dist/
mcp/**/*.egg-info/

# Local tooling and private notes
.claude/*
!.claude/skills/
.lavish/
.impeccable/
.private/

# Database snapshots and the deployed commit, written by scripts/deploy.sh
backups/
.deployed
